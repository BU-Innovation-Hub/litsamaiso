# --- Core ---
PORT=5000
NODE_ENV=development
TRUST_PROXY=
MONGO_URI=

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password

# --- Seeded AppAdmin and system institution ---
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
SYSTEM_INSTITUTION_NAME=
SYSTEM_INSTITUTION_EMAIL=

# --- Email ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_SECURE=
EMAIL_FROM=
EMAIL_LOGO_PATH=
EMAIL_LOGO_URL=
EMAIL_ACCENT_COLOR=
APP_NAME=Litsamaiso
ADMIN_EMAIL_BATCH_SIZE=
ADMIN_EMAIL_BATCH_DELAY_MS=
ADMIN_EMAIL_CONCURRENCY=

# --- Scheduler ---
AGENDA_COLLECTION=

# --- Third-party services ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=
MAX_FILE_SIZE=
GOOGLE_GENERATIVE_AI_API_KEY=
POSTHOG_HOST=
POSTHOG_PROJECT_TOKEN=

# --- Elections ---
ELECTION_HMAC_SECRET=

# --- Rate limits ---
AUTH_REGISTER_RATE_LIMIT_MAX=
AUTH_LOGIN_RATE_LIMIT_MAX=
AUTH_RESET_RATE_LIMIT_MAX=
ONBOARDING_RATE_LIMIT_MAX=

# --- Billing (Stripe) ---
# Use test-mode keys (sk_test_...) until the live Stripe account exists.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the dashboard webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=
# Public URL of the client app, used for Checkout and Customer Portal redirects.
CLIENT_BASE_URL=http://localhost:5173
BILLING_GRACE_DAYS=14
